<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.login.maintain.dao.MaintainRecordDao">

	<select id="get" resultType="com.login.maintain.domain.MaintainRecordDO">
		select * from maintain_record where id = #{value}
	</select>

	<select id="list" resultType="com.login.maintain.domain.MaintainRecordDO">
		select * from maintain_record where `status` = 1 order by id desc
	</select>

</mapper>