<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.login.app.dao.PhoneCountDao">
	<select id="get" resultType="com.login.app.domain.PhoneCountDO">
		select * from phone_count where phone = #{value}
	</select>

	<select id="list" resultType="com.login.app.domain.PhoneCountDO">
		select * from phone_count
		<where>
			<if test="phone != null and phone != ''"> and phone = #{phone}</if>
			<if test="count != null and count != ''"> and count = #{count}</if>
		</where>
		<choose>
			<when test="sort != null and sort.trim() != ''">
				order by ${sort} ${order}
			</when>
			<otherwise>
				order by phone desc
			</otherwise>
		</choose>
		<if test="offset != null and limit != null">
			limit #{offset}, #{limit}
		</if>
	</select>

	<select id="count" resultType="int">
		select count(*) from phone_count
		<where>
			<if test="phone != null and phone != ''"> and phone = #{phone} </if>
			<if test="count != null and count != ''"> and count = #{count} </if>
		</where>
	</select>

	<insert id="save" parameterType="com.login.app.domain.PhoneCountDO">
		insert into phone_count (`phone` , 	`count` ) values (#{phone} ,#{count})
	</insert>

	<update id="update" parameterType="com.login.app.domain.PhoneCountDO">
		update phone_count
		<set>
			<if test="count != null">`count` = #{count}</if>
		</set>
		where phone = #{phone}
	</update>

	<delete id="remove">
		delete from phone_count where phone = #{value}
	</delete>

	<delete id="batchRemove">
		delete from phone_count where phone in
		<foreach item="phone" collection="array" open="(" separator="," close=")">
			#{phone}
		</foreach>
	</delete>

</mapper>