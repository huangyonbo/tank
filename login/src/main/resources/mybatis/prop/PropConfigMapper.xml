<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.login.prop.dao.PropConfigDao">
	<select id="get" resultType="com.login.prop.domain.PropConfigDO">
		select * from prop_config where id = #{value}
	</select>

	<select id="list" resultType="com.login.prop.domain.PropConfigDO">
		select * from prop_config
		<where>
			<if test="id != null and id != ''"> and id = #{id} </if>
			<if test="data != null and data != ''"> and data = #{data} </if>
		</where>
		<choose>
			<when test="sort != null and sort.trim() != ''">
				order by ${sort} ${order}
			</when>
			<otherwise>
				order by id desc
			</otherwise>
		</choose>
		<if test="offset != null and limit != null">
			limit #{offset}, #{limit}
		</if>
	</select>

	<select id="count" resultType="int">
		select count(*) from prop_config
		<where>
			<if test="id != null and id != ''"> and id = #{id} </if>
			<if test="data != null and data != ''"> and data = #{data} </if>
		</where>
	</select>

	<insert id="save" parameterType="com.login.prop.domain.PropConfigDO">
		insert into prop_config
		(
			`id`,
			`data`
		)
		values
		(
			#{id},
			#{data}
		)
	</insert>

	<update id="update" parameterType="com.login.prop.domain.PropConfigDO">
		update prop_config
		<set>
			<if test="data != null">`data` = #{data}</if>
		</set>
		where id = #{id}
	</update>

	<delete id="remove">
		delete from prop_config where id = #{value}
	</delete>

	<delete id="batchRemove">
		delete from prop_config where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>