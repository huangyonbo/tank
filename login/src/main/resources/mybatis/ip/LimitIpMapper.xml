<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.login.ip.dao.LimitIpDao">
	<select id="get" resultType="com.login.ip.domain.LimitIpDO">
		select * from limit_ip where id = #{value}
	</select>

	<select id="list" resultType="com.login.ip.domain.LimitIpDO">
		select * from limit_ip
		<where>
			<if test="id != null and id != ''"> and `id` = #{id}</if>
			<if test="ip != null and ip != ''"> and `ip` = #{ip}</if>
			<if test="type != null and type != ''"> and `type` = #{type}</if>
			<if test="start != null and start != ''"> and `start` = #{start}</if>
			<if test="end != null and end != ''"> and `end` = #{end}</if>
		</where>
		<choose>
			<when test="sort != null and sort.trim() != ''">
				order by ${sort} ${order}
			</when>
			<otherwise>
				order by id desc
			</otherwise>
		</choose>
		<if test="offset != null and limit != null">
			limit #{offset}, #{limit}
		</if>
	</select>

	<select id="count" resultType="int">
		select count(*) from limit_ip
		<where>
			<if test="id != null and id != ''"> and `id` = #{id} </if>
			<if test="ip != null and ip != ''"> and `ip` = #{ip} </if>
			<if test="type != null and type != ''"> and `type` = #{type}</if>
			<if test="start != null and start != ''"> and `start` = #{start} </if>
			<if test="end != null and end != ''"> and `end` = #{end} </if>
		</where>
	</select>

	<insert id="save" parameterType="com.login.ip.domain.LimitIpDO">
		insert into limit_ip
		(`id`,`ip` ,`type`,`start`,`end`)
		values
		(#{id},#{ip},#{type},#{start} ,#{end})
	</insert>

	<update id="update" parameterType="com.login.ip.domain.LimitIpDO">
		update limit_ip
		<set>
			<if test="ip != null">`ip` = #{ip}, </if>
			<if test="type != null">`type` = #{type}, </if>
			<if test="start != null">`start` = #{start}, </if>
			<if test="end != null">`end` = #{end}</if>
		</set>
		where id = #{id}
	</update>

	<delete id="remove">
		delete from limit_ip where id = #{value}
	</delete>

	<delete id="batchRemove">
		delete from limit_ip where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>